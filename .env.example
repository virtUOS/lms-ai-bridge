# ---- Model backend (the project-wide contract; see prototypes/README.md) ----
# Any OpenAI-compatible endpoint: a LiteLLM gateway, vLLM, GWDG, OpenAI itself.
# Leave unset to run in offline echo mode — the demo still works.
OPENAI_BASE_URL=https://your-gateway.example.org/v1
OPENAI_API_KEY=
MODEL=

# Reasoning models spend most of their budget thinking before answering, so a
# cap sized for a plain model returns an empty answer that looks like a broken
# backend. Both models on the Osnabrück gateway do this — one spent 209 of 218
# tokens reasoning before saying "Hannover".
CHAT_MAX_TOKENS=1500

# ---- Bridge ----
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8080
# Maximum request body. Text-only indexing needs a few MB; a request carrying
# audio needs far more — an 18 MB recording becomes ~25 MB of base64. Inline
# upload is the prototype's weakest point; a production contract should take a
# URL the bridge fetches instead.
BRIDGE_MAX_BODY_MB=512
# Shared bearer token. Unset = no auth (prototype default, fine for a demo).
BRIDGE_TOKEN=

# ---- Retrieval provider ----
# auto       = use embeddings if EMBEDDING_MODEL is set, else lexical (default)
# embeddings = require embeddings; warns and falls back if unconfigured
# builtin    = force the lexical fallback
# none       = no retrieval; /v1/capabilities omits it, chat stays ungrounded
# external   = stub for ByCS local_ai_content / OSKI.nrw (not implemented)
#
# Reuse what the institution already runs. An embedding model gives markedly
# better retrieval — measured on a real course, it is the only thing that
# answers a question sharing no words with the material — but requiring one
# would exclude institutions that have none. So "auto" prefers it and falls
# back to lexical, which needs no infrastructure at all.
RETRIEVAL_PROVIDER=auto

# Any embedding model on the same OpenAI-compatible endpoint. Leave unset to
# run on the lexical fallback.
EMBEDDING_MODEL=
# Cosine similarity below this counts as "not relevant".
EMBEDDING_MIN_SIMILARITY=0.35
RETRIEVAL_STORE=.index.json
RETRIEVAL_BASE_URL=
RETRIEVAL_API_KEY=

# ---- LMS adapters ----
BRIDGE_URL=http://127.0.0.1:8080

# Moodle: create a token under
#   Site administration → Server → Web services → Manage tokens
MOODLE_URL=
MOODLE_TOKEN=

# Stud.IP: JSON-API, token or basic auth
STUDIP_URL=
STUDIP_TOKEN=
STUDIP_USER=
STUDIP_PASSWORD=

# ILIAS: requires the third-party RESTPlugin. UNTESTED — see adapters/ilias_adapter.py
ILIAS_URL=
ILIAS_TOKEN=
ILIAS_CLIENT_ID=
ILIAS_CLIENT_SECRET=

# ---- Transcription (audio and video) ----
# The bridge does not transcribe; it calls something that does.
#
# ASR_BACKEND picks the API shape. Leave empty to detect:
#   openai   = POST /v1/audio/transcriptions  <- what MOST institutions have
#              (faster-whisper, whisper.cpp, vLLM, LocalAI, OpenAI itself)
#   whisperx = MurmurAI's job API: POST /v1/transcript, then poll.
#              Richer — speaker labels, progress — but not the common case.
#   app      = an institution's transcription application (placeholder)
#
# Detection asks the server whether /v1/transcript exists rather than guessing
# from a hostname, and falls back to the OpenAI shape on any doubt.
ASR_BACKEND=
ASR_URL=
ASR_API_KEY=
# Whisper model, sent per request. Leave EMPTY to use whatever the server is
# configured for — Osnabrück's deployment defaults to large-v3-turbo, and not
# naming one lets that stand rather than overriding it with a guess. Set it to
# override: "large-v3-turbo", "whisper-1", "Systran/faster-whisper-large-v3".
ASR_MODEL=

# Language of the recordings. "auto" (the default) lets Whisper detect it,
# which is right whenever a course could be in more than one language — and no
# institution's courses are reliably all one. Set a code ("de", "en") only where
# a course really is single-language: detection can go wrong on a noisy opening
# or a bilingual greeting, and pinning it avoids that.
ASR_LANGUAGE=auto

# Speaker labels ("SPEAKER_00: ..." inline in the transcript). MurmurAI only —
# the OpenAI-compatible API has no diarization.
#
# This is a REQUEST, not a guarantee. The diarization models are gated on
# HuggingFace, so the ASR SERVER holds that token (MURMURAI_HF_TOKEN, set at
# deploy time — see whisperx-api-setup). The bridge neither has nor needs one:
# an API client should not carry a credential for a third-party service its
# server already holds. Without it, transcripts simply come back without
# speakers and everything else still works.
ASR_DIARIZE=true
# An ASR server is a shared institutional resource; do not saturate it.
ASR_MAX_CONCURRENT=2
# Set to "none" to never index audio at all.
TRANSCRIPTION_PROVIDER=auto

# If Whisper is served from the same gateway as your chat models, ASR_URL and
# ASR_API_KEY can be left empty — the OpenAI-compatible provider falls back to
# OPENAI_BASE_URL and OPENAI_API_KEY.
